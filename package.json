{
  "name": "teach-eletricy",
  "version": "0.2.1",
  "private": true,
  "description": "Laboratório desktop para ensino de programação PLC Siemens com simulação visual.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "optimized": "npm run build && electron .",
    "build:opcda": "electron\\\\opc-da-bridge\\\\build-opc-da-bridge.bat",
    "dev:local": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "package:dir": "npm run build && electron-builder --dir --win --x64",
    "dist:installer": "npm run build:opcda && npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build:opcda && npm run build && electron-builder --win portable --x64 --publish never",
    "dist:windows": "npm run build:opcda && npm run build && electron-builder --win nsis portable --x64 --publish never",
    "release:windows": "npm run dist:windows"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "nodes7": "^0.3.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@react-three/fiber": "^9.3.0",
    "three": "^0.180.0",
    "@react-three/drei": "^10.7.6",
    "node-opcua": "2.186.15"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.5.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.2",
    "wait-on": "^8.0.4",
    "@types/three": "^0.180.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "TEACH ELETRICY",
  "build": {
    "appId": "com.teacheletricy.desktop",
    "productName": "TEACH ELETRICY",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/opc-da-bridge/publish/x64",
        "to": "opc-da-bridge/publish/x64"
      },
      {
        "from": "electron/opc-da-bridge/publish/x86",
        "to": "opc-da-bridge/publish/x86"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "TEACH-ELETRICY"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TEACH ELETRICY",
      "uninstallDisplayName": "TEACH ELETRICY",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
